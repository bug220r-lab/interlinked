# This repository contains the reviewed source distribution only.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/repository/

# Local execution and private deployment material, at any depth.
**/__pycache__/
*.py[cod]
**/.venv/
**/venv/
**/node_modules/
**/.env
**/.env.*
**/.ssh/
**/.aws/
**/auth.json
**/Settings.json
**/State/
**/Logs/
**/ServerJobs/
**/HostLibrary/
**/Returns/
**/Cache/
**/Partials/
**/MAGIX-Workspace-State/
**/Fixture*/
**/fixtures/
**/fixture-*/
**/publisher-fixtures-*/
**/client-independent-*/
**/job-process-*/
**/job-unc-identity-*/
**/AccessFixture-*/
**/*.lock
**/*-results.json
**/*-test-results.json
**/*-receipt.json
**/catalog.json
**/catalog-source.json
**/MAGIX-All-Projects-Index.json
**/SSH-Verification-Plan.json
**/RUNTIME-VERIFICATION.json

# Source distribution excludes binary runtimes, payloads and archives.
*.exe
*.dll
*.pyd
*.zip
*.7z
*.bundle
*.sqlite
*.sqlite3
*.sqlite3-*
*.db
*.pem
*.key
*.pfx
*.p12
*.MVP
*.MV_
*.MVD
*.mp4
*.mov
*.mkv
*.avi
*.wav
*.mp3
*.jpg
*.JPG
*.png

# Keep the runtime license and import-path text, but not its payload.
/repository/outputs/Project-Library-2026-10-29/Client/Runtime/*
!/repository/outputs/Project-Library-2026-10-29/Client/Runtime/LICENSE.txt
!/repository/outputs/Project-Library-2026-10-29/Client/Runtime/python312._pth
